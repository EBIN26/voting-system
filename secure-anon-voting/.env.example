# Copy to .env. `npm run deploy` writes this for the local test chain.
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x...
# Two different keys. The election admin key must NOT be on this server.
REGISTRAR_PRIVATE_KEY=0x...
RELAYER_PRIVATE_KEY=0x...
# Both at least 32 random characters (e.g. `openssl rand -hex 32`).
ADMIN_API_KEY=
CODE_PEPPER=
MIN_VOTERS=3
# HOST=127.0.0.1
# PORT=3000
# TRUST_PROXY=1   # number of reverse proxies in front (e.g. nginx doing TLS)
