# `npm run deploy` writes a working local .env. For anything real, set each value yourself.
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x...
# The only key this server holds. It must not be the admin or a trustee.
SUBMITTER_PRIVATE_KEY=0x...
# Each at least 32 random characters (e.g. `openssl rand -hex 32`).
ID_PEPPER=
OTP_SECRET=
ADMIN_API_KEY=
# Development only: enables the MOCK Aadhaar service. Must be unset in production.
MOCK_UIDAI_SECRET=
# HOST=127.0.0.1
# PORT=3000
# TRUST_PROXY=1
# OTP_TTL_SECONDS=300
# SESSION_TTL_SECONDS=600
